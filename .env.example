# Gemini API key from Google AI Studio (free tier). Required for the LLM
# and for the primary Gemini embedding backend; without it, embeddings
# silently fall back to local MiniLM.
GOOGLE_API_KEY=

# FALSE = AI Studio (free-tier key above, no GCP billing needed).
# TRUE   = Vertex AI — flip this at deploy time (the target platform for
#          the deployed version; requires a GCP project + billing).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Chat model. gemini-3.8-flash is current GA (2026-09) but returned
# repeated 503s from this free-tier key at build time; gemini-2.5-flash was
# reliable and is the default. Try 3.8 again later if you want the newer model.
GEMINI_MODEL=gemini-2.5-flash

# Embedding model (Gemini backend only).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional overrides for tenant source paths.
# VERISIM_SOURCE_PATH=/home/z/verisim
# ARES_SOURCE_PATH=/home/z/ares

# Optional: trace export to a self-hosted Langfuse instance (v2 server).
# Create a "DevDesk" project at your Langfuse UI -> Settings -> API Keys.
# Without these, tracing is a no-op — structured JSON logs (logs/devdesk.jsonl)
# still work regardless.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
